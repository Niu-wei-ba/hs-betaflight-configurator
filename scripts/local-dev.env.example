# Local-only settings for scripts/start-local.sh.
# Copy this file to .env.local-dev and adjust only when your machine differs.

# Private sibling API repository. The default is ../hs-betaflight-firmware-api.
# BFC_LOCAL_API_DIR=/absolute/path/to/hs-betaflight-firmware-api

# Local API used by the default mode.
BFC_LOCAL_API_URL=http://127.0.0.1:4180

# API used by `yarn start:local -- -prod`.
BFC_PROD_API_URL=https://bf.hs-fpv.com

# Vite listener. Use 0.0.0.0 when a phone on the LAN needs to access the dev server.
BFC_DEV_HOST=127.0.0.1
BFC_DEV_PORT=8000

# Optional: explicit Node 20 bin directory if nvm is not available in a non-interactive shell.
# BFC_NODE20_BIN=$HOME/.nvm/versions/node/v20.20.2/bin
