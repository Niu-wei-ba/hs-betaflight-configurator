{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hs-fpv.com/schemas/firmware-mirror-manifest_schema-1.0.json",
  "title": "HS-FPV Firmware Mirror Manifest Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "releaseBaseUrl",
    "defaults",
    "versions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseBaseUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "defaults": {
      "type": "object",
      "required": [
        "manufacturer",
        "configuration"
      ],
      "properties": {
        "manufacturer": {
          "type": "string"
        },
        "configuration": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "channel",
          "releaseType",
          "date",
          "hot",
          "targets"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "rc",
              "dev"
            ]
          },
          "releaseType": {
            "type": "string",
            "enum": [
              "Stable",
              "ReleaseCandidate",
              "Unstable"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "hot": {
            "type": "boolean"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "target",
                "mcu",
                "group",
                "cloudBuild",
                "hot",
                "artifact"
              ],
              "properties": {
                "target": {
                  "type": "string"
                },
                "mcu": {
                  "type": "string"
                },
                "group": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "unsupported",
                    "legacy"
                  ]
                },
                "cloudBuild": {
                  "type": "boolean"
                },
                "hot": {
                  "type": "boolean"
                },
                "configuration": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "buildTarget": {
                  "type": "string"
                },
                "buildOptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "betaflight-cloud-build",
                        "github-release-asset",
                        "url"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "repo": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "assetName": {
                      "type": "string"
                    },
                    "buildTarget": {
                      "type": "string"
                    },
                    "buildApiBaseUrl": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "release": {
                      "type": "string"
                    },
                    "commit": {
                      "type": "string"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "artifact": {
                  "type": "object",
                  "required": [
                    "fileName",
                    "objectKey"
                  ],
                  "properties": {
                    "fileName": {
                      "type": "string"
                    },
                    "objectKey": {
                      "type": "string",
                      "pattern": "^/"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
