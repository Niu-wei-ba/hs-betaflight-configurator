# Firmware gateway selection
#
# Published Web/PWA builds use their own HTTPS origin by default, so BuildApi requests
# reach the same-origin /api gateway. Google map tiles use the same gateway. Desktop shells
# and unconfigured local development continue to call the official upstream services.
#
# Set an absolute gateway URL to override the default in any runtime, for example:
# VITE_BUILD_API_BASE_URL=https://bf.hs-fpv.com
#
# To exercise the gateway through the local Vite proxy, use the current Vite origin:
# VITE_BUILD_API_BASE_URL=/
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:4180
# VITE_DEV_PROXY_CHANGE_ORIGIN=false
#
# For an online gateway during local testing:
# VITE_DEV_PROXY_TARGET=https://bf.hs-fpv.com
# VITE_DEV_PROXY_CHANGE_ORIGIN=true
