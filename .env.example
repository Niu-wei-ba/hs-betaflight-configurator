VITE_APP_NAME=HS-FPV | Betaflight镜像站
VITE_APP_TAGLINE=一个专注镜像部署的 Betaflight 兼容调参工具，支持固件刷写与预设托管。
VITE_SOURCE_CODE_URL=https://github.com/Niu-wei-ba/betaflight-configurator
VITE_DOCS_BASE_URL=http://127.0.0.1:4180/docs/wiki
VITE_BUILD_API_BASE_URL=http://127.0.0.1:4180
VITE_PRESETS_OFFICIAL_URL=http://127.0.0.1:4180/presets/firmware-presets/
VITE_PRESETS_BACKUP_URL=http://127.0.0.1:4180/presets/firmware-presets/
VITE_DOCUMENTATION_LABEL=Documentation

# Standalone firmware API production-style settings.
# FIRMWARE_METADATA_BASE_URL should point to the COS/CDN prefix that contains manifest.json and index/*.json.
# FIRMWARE_ARTIFACT_BASE_URL should point to the CDN prefix that contains firmware/stable/... objects.
FIRMWARE_METADATA_BASE_URL=https://cdn.example.com/mirror-metadata
FIRMWARE_ARTIFACT_BASE_URL=https://cdn.example.com
FIRMWARE_METADATA_DIR=artifacts/firmware-metadata
