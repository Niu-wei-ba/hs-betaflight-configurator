VITE_APP_NAME=HS-FPV | Betaflight镜像站
VITE_APP_TAGLINE=一个专注镜像部署的 Betaflight 兼容调参工具，支持固件刷写与预设托管。
VITE_SOURCE_CODE_URL=https://github.com/Niu-wei-ba/betaflight-configurator
# Local dev uses Vite same-origin proxying by default.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:4180
# Optional overrides if your deployment does not serve the mirror API and docs from the same origin:
# VITE_BUILD_API_BASE_URL=https://mirror.example.com
# VITE_DOCS_BASE_URL=https://mirror.example.com/docs/wiki
VITE_PROXY_THIRD_PARTY_PRESETS=true
# Omit or set to false: firmware version list matches official (all releases from /api/targets/{target}).
# Set to true only if the mirror should hide versions not listed in /api/firmware/versions.
# VITE_FIRMWARE_USE_VERSION_INDEX_FILTER=true
# Optional preset source overrides:
# VITE_PRESETS_OFFICIAL_URL=https://mirror.example.com/presets/firmware-presets/
# VITE_PRESETS_BACKUP_URL=https://mirror.example.com/presets/firmware-presets/
VITE_DOCUMENTATION_LABEL=文档
